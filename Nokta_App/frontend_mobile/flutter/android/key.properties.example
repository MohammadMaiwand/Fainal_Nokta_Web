# Copy to android/key.properties (gitignored) before Play Store release.
# Generate keystore (from android/ directory):
#   keytool -genkey -v -keystore nokta-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias nokta
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=nokta
storeFile=nokta-upload-key.jks
