# Dependencies
node_modules/

# Build outputs
dist/
dist-current/
build/
.vite/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/*.log
frontend/*.log
logs/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test / coverage artifacts
test-results/
playwright-report/
coverage/
.nyc_output/

# Database backups (local dev only)
backups/
*.backup
*.bak

# Browser automation profiles / cache (sensitive + huge)
**/.chrome-profile/
**/chrome-profile/
**/chrome-profile*/
**/BrowserMetrics/
**/Crashpad/
**/Cookies
**/Cookies-journal
**/Login Data
**/Login Data-journal
**/Network Persistent State
**/Secure Preferences

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/

# Android signing (never commit)
**/android/key.properties
**/*.jks
**/*.keystore

# Flutter build outputs (any package path)
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Agent / local tooling
.agent/cache/

# Optional local runtime validation output
.runtime-validation/output/
.offline-runtime/
.start-program-runtime/
