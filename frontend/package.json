{
  "name": "nokta-academy-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/updateProjectProgress.js",
    "preview": "vite preview",
    "update-progress": "node scripts/updateProjectProgress.js",
    "validate-permissions": "node scripts/validatePermissionMenus.mjs",
    "validate-translations": "node scripts/validateTranslations.mjs",
    "validate-finance-locales": "node scripts/validateFinanceLocales.mjs",
    "validate-finance-route-guards": "node scripts/validateFinanceRouteGuards.mjs",
    "sync-locale-extras": "node scripts/syncEnLocaleExtras.mjs",
    "validate-dari": "node scripts/validateDariTerms.mjs",
    "normalize-dari": "node scripts/normalizeDariFa.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2ePublicSmoke.mjs",
    "test:e2e:finance": "node scripts/e2eFinanceSmoke.mjs",
    "test:e2e:browser": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:offline": "node scripts/offlineRuntimeValidate.mjs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.4.0",
    "axios": "^1.6.2",
    "dayjs": "^1.11.20",
    "framer-motion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "i18next": "^23.1.0",
    "jalaliday": "^3.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.521.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^13.0.0",
    "react-router-dom": "^6.18.0",
    "recharts": "^2.15.4",
    "yup": "^1.7.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
