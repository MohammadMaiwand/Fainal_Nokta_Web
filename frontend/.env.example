# Match backend PORT from backend/.env (default 8081, some installs use 4000)
VITE_API_URL=http://localhost:8081/api
VITE_API_BASE_URL=http://localhost:8081/api
# Dev-only: Vite proxy target (auto-reads backend/.env PORT when unset)
# VITE_DEV_API_PROXY=http://127.0.0.1:4000
VITE_SENTRY_DSN=
VITE_ERROR_REPORT_URL=
# Set true only in local/staging to show demo role shortcuts on login (never in production)
VITE_ENABLE_DEMO_LOGIN=false
